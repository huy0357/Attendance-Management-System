{
    "name": "ams-fe",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "prestart": "npx --yes kill-port 4200",
        "start": "ng serve --port 4200",
        "start:debug": "ng serve --port 4200 --verbose",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "lint": "npx ng lint --format=stylish",
        "lint:fix": "npx ng lint --fix --format=stylish",
        "lint:debug": "npx ng lint --format=stylish --force",
        "lint:json": "npx ng lint --format=json > eslint-report.json"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "packageManager": "npm@11.6.2",
    "dependencies": {
        "@angular/common": "^21.1.0",
        "@angular/compiler": "^21.1.0",
        "@angular/core": "^21.1.0",
        "@angular/forms": "^21.1.0",
        "@angular/platform-browser": "^21.1.0",
        "@angular/platform-browser-dynamic": "^21.1.0",
        "@angular/router": "^21.1.0",
        "lucide-angular": "^0.563.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^21.1.2",
        "@angular/cli": "^21.1.2",
        "@angular/compiler-cli": "^21.1.0",
        "@angular-eslint/builder": "^21.0.0",
        "@angular-eslint/eslint-plugin": "^21.0.0",
        "@angular-eslint/eslint-plugin-template": "^21.0.0",
        "@angular-eslint/schematics": "^21.0.0",
        "@angular-eslint/template-parser": "^21.0.0",
        "@typescript-eslint/eslint-plugin": "^8.46.1",
        "@typescript-eslint/parser": "^8.46.1",
        "cypress": "^15.10.0",
        "eslint": "^9.39.1",
        "jsdom": "^27.1.0",
        "typescript": "~5.9.2",
        "vitest": "^4.0.8"
    }
}
