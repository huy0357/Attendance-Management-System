APP_NAME=ams-chatbot-service
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8088
APP_DEBUG=true

AMS_BE_BASE_URL=http://host.docker.internal:8080
AMS_BE_TIMEOUT_SECONDS=8
AMS_BE_JWT_VALIDATE_PATH=/api/auth/introspect

RASA_URL=http://rasa:5005
RASA_ACTIONS_URL=http://rasa-actions:5055

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=ams_knowledge_v1
QDRANT_TOP_K=5
QDRANT_SCORE_THRESHOLD=0.55

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=20

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3

CACHE_ENABLED=true
CACHE_TTL_SECONDS=120

LOG_LEVEL=INFO
