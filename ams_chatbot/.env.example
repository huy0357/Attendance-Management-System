APP_NAME=ams-chatbot-service
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8088
APP_DEBUG=true

AMS_BE_BASE_URL=http://localhost:8080
AMS_BE_TIMEOUT_SECONDS=8
AMS_BE_JWT_VALIDATE_PATH=/api/v1/auth/introspect

RASA_URL=http://localhost:5005
RASA_ACTIONS_URL=http://localhost:5055

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ams_knowledge_v1
QDRANT_TOP_K=5
QDRANT_SCORE_THRESHOLD=0.55

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=20

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3

CACHE_ENABLED=true
CACHE_TTL_SECONDS=120

LOG_LEVEL=INFO
